  font-size: 1.05rem;
  font-weight: 900;
  white-space: nowrap;
}

.hyper-score-link {
  border: 0;
  padding: 0;
  cursor: pointer;
  background: transparent;
}

.hyper-progress-frame {
  position: relative;
  display: grid;
  place-items: center;
  width: min(100%, 10rem);
