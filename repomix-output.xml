  }

  .hyper-support-list .hyper-support-button {
    display: grid;
    grid-template-columns: 4.7vh minmax(0, 1fr);
    column-gap: 0.35rem;
    width: 100%;
    min-height: 6.8vh;
    height: 6.8vh;
    border-radius: 36px;
    padding: 0.35rem 2.2vh 0.35rem 0.45rem;
  }

  .hyper-support-list .hyper-support-icon {
    width: 4.7vh;
    height: 4.7vh;
    flex: 0 0 4.7vh;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    align-self: center;
    object-fit: contain;
  }

  .hyper-support-list .hyper-support-label {
    display: flex;
    align-items: center;
    align-self: center;
    justify-content: flex-start;
    min-width: 0;
    min-height: 0;
    height: 100%;
    padding: 0 0 0 8px;
    font-size: 1.75vh;
    font-weight: 900;
    line-height: 1.15;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }



  .hyper-action-orb {
    position: relative;
    width: 5.45vh;
    height: 5.45vh;
    display: grid;
    place-items: center;
    margin: 0;
    border: 4px solid #ffbd19;
    border-radius: 50%;
    padding: 0;
    background: radial-gradient(circle at 36% 28%, #8f43d4, #57209b 64%, #3c116f);
    box-shadow:
      0 0 0 2px #c89aff,
      0 0 0 4px #44108e,
      inset 0 3px 4px rgba(255, 255, 255, 0.42),
      inset 0 -4px 5px rgba(48, 10, 90, 0.25),
      0 6px 10px rgba(65, 20, 110, 0.28);
    cursor: pointer;
    transition: transform 150ms ease, filter 150ms ease;
  }

  .hyper-action-orb:hover {
    transform: translateY(-2px) scale(1.04);
    filter: brightness(1.08);
  }

  .hyper-action-orb:active {
    transform: translateY(2px) scale(0.95);
  }

  .hyper-action-orb:focus-visible {
    outline: 2px solid #ffbd19;
    outline-offset: 2px;
  }

  .hyper-action-orb-mobile {
    position: relative;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border: 2px solid #ffbd19;
    border-radius: 50%;
    background: radial-gradient(circle at 36% 28%, #8f43d4, #57209b 64%, #3c116f);
    box-shadow:
      0 0 0 1px #c89aff,
      0 0 0 2px #44108e,
      inset 0 2px 3px rgba(255, 255, 255, 0.42),
      inset 0 -2px 3px rgba(48, 10, 90, 0.25),
      0 4px 6px rgba(65, 20, 110, 0.28);
    cursor: pointer;
    color: #fff;
  }

  .hyper-action-orb-icon {
    width: 58%;
    height: 58%;
    object-fit: contain;
    filter: drop-shadow(0 1px 1px rgba(48, 12, 84, 0.62));
  }

  .hyper-action-orb-mobile .hyper-pause-icon {
    font-size: 1rem;
    font-weight: 900;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  .hyper-pause-icon {
    color: #fff4d7;
    font-size: 2.7vh;
    font-weight: 900;
    line-height: 1;
    text-shadow: 0 2px 0 rgba(48, 12, 84, 0.72);
    letter-spacing: 0.1em;
    user-select: none;
  }

  .hyper-timer {
    position: absolute;
    z-index: 4;
    top: 10%;
    bottom: 10%;
    left: -35px;
    display: block;
    width: 30px;
    height: auto;
    max-height: none;
    pointer-events: none;
    filter: drop-shadow(0 6px 7px rgba(83, 34, 4, 0.22));
  }

  .hyper-timer-clock {
    position: absolute;
    z-index: 3;
    top: 0;
    left: 0.4vh;
    display: grid;
    width: 4.5vh;
    height: 4.5vh;
    place-items: center;
    border: 3px solid #f6ac0d;
    border-radius: 50%;
    background: #fff7df;
    box-shadow: 0 0 0 2px #ffe974, 0 0 0 4px #c86a08, inset 0 2px 3px #fff;
  }

  .hyper-timer-clock img {
    width: 3.5vh;
    height: 3.5vh;
    object-fit: contain;
  }

  .hyper-timer-track {
    position: absolute;
    z-index: 1;
    top: 3.4vh;
    bottom: 0;
    left: 1.25vh;
    width: 2.75vh;
    overflow: hidden;
    border: 3px solid #f5a40b;
    border-radius: 14px;
    background: linear-gradient(0deg, #1e0a04, #301008 50%, #3d1406);
    box-shadow: 0 0 0 2px #ffe66f, 0 0 0 4px #ba5b08, inset 0 0 8px rgba(14, 4, 0, 0.9);
  }

  /* fill anchored to BOTTOM — countdown bar shrinks from top */
  .hyper-timer-track span {
    position: absolute;
    right: 3px;
    bottom: 3px;
    left: 3px;
    min-height: 4%;
    border-radius: 10px;
    /* background set inline from React for color transitions */
    box-shadow: inset 2px 0 3px rgba(255, 255, 255, 0.42), 0 0 8px rgba(32, 225, 239, 0.55);
    transition: height 300ms linear;
  }

  .hyper-board-stage {
    height: 100%;
    min-width: 0;
    align-self: stretch;
  }

  .hyper-board-stage .game-board-frame {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    aspect-ratio: auto;
  }
}

@keyframes hyper-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes hyper-modal-in { from { opacity: 0; transform: translateY(8px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }

@media (max-width: 639px) {
  .hyper-title-bar { min-height: 42px; padding-inline: 1.75rem; font-size: 0.78rem; }
  .hyper-panel { border-radius: 18px; }
  .hyper-support-button--mini {
    justify-content: center;
    min-height: 40px;
    width: 40px;
    border-radius: 20px;
    padding: 0;
    margin: 0;
    overflow: visible;
  }

  .hyper-support-button--mini .hyper-support-icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .hyper-support-button--mini .hyper-support-counter {
    right: -4px;
    top: auto;
    bottom: -2px;
    transform: none;
    width: 18px; min-width: 18px; padding: 0;
    height: 18px;
    font-size: 0.5rem;
  }

  .hyper-info-row { min-height: 52px; padding-left: 3rem; }
  .hyper-info-icon { width: 2.7rem; height: 2.7rem; }
  .hyper-progress-frame { width: min(42vw, 9rem); }
  .hyper-modal { padding: 0.55rem; border-radius: 20px; }
  .hyper-modal-inner { padding: 0.75rem; }
  .hyper-result-card { width: min(92%, 25rem); padding: 0.7rem; border-radius: 20px; }
  .hyper-result-inner { padding: 0.75rem; }
}

@media (min-width: 1024px) and (max-height: 800px) {
  .hyper-sidebar-support {
    width: min(100%, 276px);
    margin-top: 38px;
  }

  .hyper-support-title {
    height: 42px;
    min-height: 42px;
  }

  .hyper-support-list {
    grid-template-rows: repeat(3, 60px);
    gap: 6px;
    margin-top: 6px;
  }

  .hyper-support-list .hyper-support-button {
    height: 60px;
    min-height: 60px;
  }

  /* The compact short-height row has a smaller content box than the normal
   * proportional row. Lift the font box slightly so its optical center stays
   * on the card center instead of drifting toward the lower edge. */
  .hyper-support-list .hyper-support-label {
    transform: translateY(-0.15rem);
  }

  .hyper-support-list .hyper-support-icon {
    width: 48px;
    height: 48px;
    flex-basis: 56px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hyper-support-button,
  .hyper-action-button,
  .hyper-icon-button,
  .hyper-close-button { transition: none; }
  .hyper-modal-backdrop,
  .hyper-modal,
  .hyper-toast { animation: none; }
}

/* Pause Modal */
.hyper-modal-backdrop--pause {
  background: rgba(20, 14, 10, 0.45);
  backdrop-filter: blur(8px);
}

.hyper-modal--pause {
  width: min(90vw, 420px);
  padding: 1.5rem;
  border-radius: 32px;
}

.hyper-modal-inner--pause {
  padding: 2rem 1.5rem;
  background: rgba(255, 248, 231, 0.95);
  box-shadow: inset 0 2px 10px rgba(255, 255, 255, 0.8), 0 10px 25px rgba(50, 15, 89, 0.15);
  border-radius: 24px;
}

.hyper-pause-title {
  color: var(--hyper-purple-ink);
  font-size: 1.8rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  text-shadow: 0 2px 0 rgba(255, 255, 255, 0.8);
  margin-bottom: 2rem;
  text-align: center; white-space: nowrap;
}

.hyper-pause-continue {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  max-width: 280px;
  min-height: 72px;
  border: 3px solid #ff9d00;
  border-radius: 36px;
  background: linear-gradient(180deg, #ffb830, #f4771a);
  color: #fff;
  font-size: 1.4rem;
  font-weight: 900;
  text-shadow: 0 2px 4px rgba(180, 50, 0, 0.5);
  box-shadow: 
    inset 0 -4px 0 rgba(200, 59, 77, 0.4),
    inset 0 2px 0 rgba(255, 255, 255, 0.6),
    0 8px 16px rgba(200, 60, 20, 0.3);
  transition: transform 150ms ease, box-shadow 150ms ease;
  margin-bottom: 2rem;
}

.hyper-pause-continue:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 
    inset 0 -4px 0 rgba(200, 59, 77, 0.4),
    inset 0 2px 0 rgba(255, 255, 255, 0.6),
    0 12px 24px rgba(200, 60, 20, 0.4);
}

.hyper-pause-continue:active {
  transform: translateY(2px) scale(0.98);
  box-shadow: 
    inset 0 -2px 0 rgba(200, 59, 77, 0.4),
    inset 0 2px 0 rgba(255, 255, 255, 0.6),
    0 4px 8px rgba(200, 60, 20, 0.3);
}

.hyper-pause-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.5rem;
  width: 100%;
}

.hyper-pause-action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  color: var(--hyper-brown);
  font-weight: 800;
  font-size: 0.85rem;
  transition: opacity 150ms ease, transform 150ms ease;
}

.hyper-pause-action-btn:hover {
  transform: translateY(-2px);
}

.hyper-pause-action-btn:active {
  transform: translateY(1px);
}

.hyper-pause-action-btn.off {
  opacity: 0.6;
  filter: grayscale(0.8);
}

.hyper-pause-action-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3.5rem;
  height: 3.5rem;
  border-radius: 50%;
  background: linear-gradient(145deg, #fff9ea, #f9dfa8);
  border: 2px solid #f3a30c;
  color: #d97918;
  box-shadow: 
    inset 0 -3px 4px rgba(181, 91, 10, 0.15),
    inset 0 2px 0 rgba(255, 255, 255, 0.9),
    0 4px 8px rgba(118, 60, 8, 0.15);
}

/* MODAL SYSTEM OVERHAUL */
.hyper-modal-backdrop {
  position: absolute;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  background-color: rgba(30, 15, 45, 0.65);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.hyper-modal-v2 {
  width: 100%;
  max-width: 440px;
  background: var(--hyper-cream);
  border: 4px solid var(--hyper-gold);
  border-radius: 28px;
  box-shadow: 
    0 12px 32px rgba(30, 10, 50, 0.4),
    inset 0 4px 0 rgba(255, 255, 255, 0.6),
    inset 0 -6px 0 rgba(189, 104, 16, 0.15);
  padding: 24px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  overflow: hidden;
}

@media (min-width: 640px) {
  .hyper-modal-v2 {
    padding: 28px 32px;
  }
}

.hyper-modal-btn {
  width: 100%;
  border-radius: 999px;
  padding: 14px 20px;
  font-family: inherit;
  font-weight: 800;
  transition: transform 0.1s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hyper-modal-btn:active:not(:disabled) {
  transform: scale(0.96);
}

.hyper-modal-btn-primary {
  background: linear-gradient(180deg, #f0548a, #c51b5c);
  border: 3px solid var(--hyper-gold);
  color: white;
  box-shadow: 
    0 6px 16px rgba(197, 27, 92, 0.4),
    inset 0 3px 0 rgba(255, 255, 255, 0.4),
    inset 0 -4px 0 rgba(135, 11, 57, 0.5);
  text-shadow: 0 2px 2px rgba(135, 11, 57, 0.8);
}

.hyper-modal-btn-secondary {
  background: transparent;
  border: 2px solid var(--hyper-gold);
  color: var(--hyper-brown);
  box-shadow: 
    0 4px 8px rgba(189, 104, 16, 0.15),
    inset 0 2px 0 rgba(255, 255, 255, 0.6);
  font-size: 1rem;
}

.hyper-fade-in {
  animation: hyperFadeIn 0.2s ease-out forwards;
}

.hyper-scale-up {
  animation: hyperScaleUp 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes hyperFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes hyperScaleUp {
  0% { transform: scale(0.92); opacity: 0; }
  70% { transform: scale(1.03); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.shadow-text {
  text-shadow: 0 2px 4px rgba(0,0,0,0.3);
}

.hyper-score-animate {
  display: inline-block;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.hyper-score-animate.doubling {
  transform: scale(1.3);
  color: var(--hyper-orange);
}

.hyper-heart {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.hyper-heart--empty {
  filter: grayscale(1) opacity(0.3) scale(0.85);
}
.hyper-support-counter {
  transition: all 0.2s;
}
.hyper-support-counter--has-stock {
  color: var(--hyper-gold);
  transform: translateY(-50%) scale(1.15);
  text-shadow: 0 1px 2px rgba(0,0,0,0.5);
}
