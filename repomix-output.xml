  background: linear-gradient(180deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0) 40%);
}

.hyper-support-button:hover {
  transform: translateY(-2px) scale(1.025);
  box-shadow:
    0 0 0 2px #ffdf67,
