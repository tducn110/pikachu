  text-align: left;
  background: linear-gradient(145deg, #fff9ea, #f9dfa8 76%, #efbd62);
  box-shadow:
    0 0 0 2px #ffdf67,
    inset 0 0 0 2px rgba(255, 255, 255, 0.9),
    inset 0 -3px 6px rgba(181, 91, 10, 0.10),
    0 5px 8px rgba(118, 60, 8, 0.16);
  transition: transform 150ms ease, filter 150ms ease, box-shadow 150ms ease;
  touch-action: manipulation;
}

.hyper-support-button::before {
  position: absolute;
  inset: 0;
  border-radius: 999px;
  content: "";
