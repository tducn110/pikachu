  filter: drop-shadow(0 4px 7px rgba(83, 41, 13, 0.14));
}

.hyper-info-icon {
  position: absolute;
  left: 0.22rem;
  width: 3.05rem;
  height: 3.05rem;
  object-fit: contain;
}

.hyper-info-label {
  min-width: 0;
  font-size: 0.88rem;
  font-weight: 900;
  line-height: 1.05;
}

.hyper-info-value {
