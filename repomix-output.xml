  font-weight: 900;
}

.hyper-action-button {
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  border: 2px solid var(--hyper-gold-deep);
  border-radius: 15px;
  padding: 0.6rem 1rem;
  color: #fff7dd;
  font-size: 0.75rem;
  font-weight: 900;
  background: linear-gradient(180deg, #8e43d3, #57209a 72%, #3b116e);
  box-shadow: 0 6px 0 #35105f, 0 10px 15px rgba(68, 25, 107, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.38);
  cursor: pointer;
  text-shadow: 0 2px 0 rgba(48, 12, 84, 0.72);
  transition: transform 140ms ease, filter 140ms ease, box-shadow 140ms ease;
  touch-action: manipulation;
}

.hyper-action-button:hover {
  transform: translateY(-2px) scale(1.02);
  filter: brightness(1.08);
}

.hyper-action-button:active {
  transform: translateY(4px) scale(0.97);
  box-shadow: 0 2px 0 #35105f, 0 5px 9px rgba(68, 25, 107, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.24);
}

.hyper-action-button--secondary {
  color: var(--hyper-purple-ink);
  background: linear-gradient(180deg, #fff9e9, #f1d39a);
  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.9);
  box-shadow: 0 5px 0 #bd6810, 0 9px 14px rgba(83, 41, 13, 0.18), inset 0 1px 0 #fff;
}

.hyper-icon-button {
  display: grid;
  width: 2.8rem;
  height: 2.8rem;
  place-items: center;
  border: 0;
  border-radius: 50%;
  padding: 0;
  color: var(--hyper-purple-ink);
  cursor: pointer;
  background: url("/hyper-ui/surfaces/info-row.webp") center / 100% 100% no-repeat;
  filter: drop-shadow(0 5px 7px rgba(83, 41, 13, 0.18));
  transition: transform 140ms ease, filter 140ms ease;
}

.hyper-icon-button:hover { transform: translateY(-2px) scale(1.04); filter: drop-shadow(0 8px 10px rgba(83, 41, 13, 0.24)) brightness(1.04); }
.hyper-icon-button:active { transform: translateY(1px) scale(0.94); }
.hyper-icon-button img { width: 2rem; height: 2rem; object-fit: contain; }

.hyper-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-inline: 1rem;
  padding-bottom: 12vh;
  background: rgba(41, 17, 70, 0.58);
  backdrop-filter: blur(10px);
  animation: hyper-fade-in 180ms ease-out both;
}

.hyper-modal {
  width: min(100%, 27rem);
  max-height: min(90dvh, 42rem);
  overflow: auto;
  padding: 0.75rem;
  border: 0;
  border-radius: 25px;
  background: url("/hyper-ui/surfaces/panel-frame.webp") center / 100% 100% no-repeat;
  box-shadow: 0 22px 60px rgba(35, 11, 65, 0.38);
  animation: hyper-modal-in 220ms cubic-bezier(0.2, 0.85, 0.3, 1.15) both;
}

.hyper-modal-inner {
  border-radius: 17px;
  padding: 1rem;
  background: rgba(255, 248, 231, 0.88);
}

.hyper-modal-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  color: var(--hyper-purple-ink);
  font-size: 1.2rem;
  font-weight: 900;
}

.hyper-close-button {
  display: grid;
  width: 2rem;
  height: 2rem;
  place-items: center;
  border: 2px solid var(--hyper-gold-deep);
  border-radius: 50%;
  color: #fff8e7;
  background: linear-gradient(180deg, #8e43d3, #4c1687);
  cursor: pointer;
  transition: transform 140ms ease;
}

.hyper-close-button:hover { transform: rotate(8deg) scale(1.06); }
.hyper-close-button:active { transform: scale(0.92); }

.hyper-setting-row,
.hyper-score-row {
  display: flex;
  min-height: 58px;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  border: 0;
  border-radius: 15px;
  padding: 0.45rem 0.85rem 0.45rem 3.2rem;
  color: var(--hyper-brown);
  text-align: left;
  background: url("/hyper-ui/surfaces/info-row.webp") center / 100% 100% no-repeat;
  filter: drop-shadow(0 4px 6px rgba(83, 41, 13, 0.12));
}

.hyper-setting-row { position: relative; cursor: pointer; }
.hyper-setting-row > img { position: absolute; left: 0.2rem; width: 2.7rem; height: 2.7rem; object-fit: contain; }
.hyper-setting-label { font-size: 0.76rem; font-weight: 900; line-height: 1.05; }
.hyper-toggle { display: grid; width: 2.7rem; height: 1.42rem; align-items: center; border: 2px solid var(--hyper-gold-deep); border-radius: 999px; padding: 0.12rem; background: #7b45b4; }
.hyper-toggle > span { display: block; width: 1rem; height: 1rem; border-radius: 50%; background: #fff8e7; transition: transform 160ms ease; }
.hyper-toggle--on { background: #f4771a; }
.hyper-toggle--on > span { transform: translateX(1.18rem); }

.hyper-score-row { padding-left: 0.85rem; }
.hyper-score-label { font-size: 0.76rem; font-weight: 900; }
.hyper-score-value { font-size: 1.25rem; font-weight: 900; }

.hyper-toast {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 50;
  display: grid;
  min-width: min(84%, 20rem);
  place-items: center;
  transform: translate(-50%, -50%);
  border: 3px solid var(--hyper-gold);
  border-radius: 22px;
  padding: 0.75rem 1.2rem;
  color: var(--hyper-purple-ink);
  text-align: center; white-space: nowrap;
  background: rgba(255, 248, 231, 0.96);
  box-shadow: 0 12px 30px rgba(59, 17, 110, 0.26), inset 0 1px 0 #fff;
  animation: hyper-modal-in 200ms ease-out both;
}

.hyper-toast-title { font-size: 1.02rem; font-weight: 900; }
.hyper-toast-copy { margin-top: 0.15rem; color: var(--hyper-brown); font-size: 0.76rem; font-weight: 700; }
.hyper-toast img { width: 3rem; height: 3rem; object-fit: contain; }

.hyper-result-card {
  display: flex;
  width: min(88%, 27rem);
  max-height: 90%;
  flex-direction: column;
  align-items: center;
  overflow: auto;
  border: 0;
  border-radius: 25px;
  padding: 1.1rem;
  color: var(--hyper-purple-ink);
  text-align: center; white-space: nowrap;
  background: url("/hyper-ui/surfaces/panel-frame.webp") center / 100% 100% no-repeat;
  box-shadow: 0 18px 42px rgba(50, 15, 89, 0.35);
}

.hyper-result-inner { width: 100%; border-radius: 17px; padding: 1rem; background: rgba(255, 248, 231, 0.88); }
.hyper-result-card h2 { font-size: clamp(1.35rem, 5vw, 2rem); font-weight: 900; }
.hyper-result-card p { color: var(--hyper-brown); font-size: 0.82rem; font-weight: 700; }
.hyper-result-score { margin-top: 0.55rem; color: var(--hyper-orange); font-size: 1.1rem; font-weight: 900; }
.hyper-result-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.55rem; margin-top: 1rem; }

.hyper-board-outer {
  border: 2px solid rgba(189, 104, 16, 0.54);
  border-radius: 24px;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.55), transparent 34%), rgba(241, 211, 154, 0.8);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85), 0 10px 24px rgba(83, 41, 13, 0.13);
}

.hyper-board-inner {
  position: relative;
  border: 2px solid rgba(189, 104, 16, 0.42);
  border-radius: 20px;
  background: rgba(255, 248, 231, 0.66);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.hyper-board-inner > .flex {
  position: relative;
  z-index: 1;
}

.hyper-game-viewport {
  padding: 0.25rem;
}

.hyper-game-stage {
  max-width: 1460px;
  overflow: hidden;
}

.hyper-game-layout {
  gap: 0.5rem;
}

.hyper-board-stage {
  position: relative;
  overflow: hidden;
}

.hyper-board-stage .game-board-frame {
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
}

.hyper-sidebar,
.hyper-sidebar-frame,
.hyper-sidebar-content {
  position: relative;
}

.hyper-sidebar-frame,
.hyper-timer {
  display: none;
}

.hyper-main-frame {
  position: relative;
  display: flex;
  width: 100%;
  border: 20px solid transparent;
  border-right-width: 12px;
  border-left-width: 12px;
  border-image-source: url("/hyper-ui/surfaces/panel-frame.webp");
  border-image-slice: 96 101 fill;
  border-image-width: 20px 12px;
  border-image-repeat: stretch;
  filter: drop-shadow(0 15px 25px rgba(90, 45, 10, 0.4));
}

/* Mobile has a fixed viewport, a two-row header, and a bottom support rail.
 * Let the frame consume the remaining flex slot instead of locking it to
 * 74vh. This keeps the 8/10-row boards inside the canvas on short phones. */
@media (max-width: 1023px) {
  .hyper-game-stage {
    gap: 0.5rem;
  }

  .hyper-main-frame {
    height: auto;
    min-height: 0;
    flex: 1 1 auto;
    margin-block: 0;
  }

  .hyper-board-stage,
  .hyper-game-layout {
    min-height: 0;
  }

  .hyper-action-orb-mobile {
    position: relative;
    display: grid;
    width: 28px;
    min-width: 28px;
    max-width: 28px;
    height: 28px;
    min-height: 28px;
    max-height: 28px;
    flex: 0 0 28px;
    place-items: center;
    padding: 0;
    border: 2px solid #ffbd19;
    border-radius: 50%;
    color: #fff;
    background: radial-gradient(circle at 36% 28%, #8f43d4, #57209b 64%, #3c116f);
    box-shadow:
      0 0 0 1px #c89aff,
      0 0 0 2px #44108e,
      inset 0 2px 3px rgba(255, 255, 255, 0.42),
      inset 0 -2px 3px rgba(48, 10, 90, 0.25),
      0 4px 6px rgba(65, 20, 110, 0.28);
    cursor: pointer;
  }

  .hyper-action-orb-mobile .hyper-action-orb-icon {
    width: 16px;
    height: 16px;
    object-fit: contain;
    filter: drop-shadow(0 1px 1px rgba(48, 12, 84, 0.62));
  }

  .game-mobile-progress {
    width: 100%;
    border-color: rgba(189, 104, 16, 0.42);
  }

  .game-mobile-progress-track {
    height: 0.7rem;
    overflow: hidden;
    border: 2px solid rgba(189, 104, 16, 0.42);
    border-radius: 999px;
    background: #e8c37d;
    box-shadow: inset 0 2px 5px rgba(86, 43, 17, 0.2);
  }

  .game-mobile-progress-fill {
    height: 100%;
    min-width: 2%;
    border-radius: inherit;
    background: linear-gradient(90deg, #5bea2d 0%, #21e8dc 55%, #ffbe2e 100%);
    transition: width 260ms linear;
  }
}

@media (min-width: 1024px) {
  .hyper-game-root {
    padding: 18px 0 12px;
  }

