  filter: drop-shadow(0 7px 10px rgba(83, 41, 13, 0.18));
}

.hyper-progress-core {
  position: absolute;
  inset: 17%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3px solid rgba(111, 39, 184, 0.65);
  border-radius: 50%;
  color: var(--hyper-purple-ink);
  background: radial-gradient(circle at 35% 28%, #fffdf5, #f5dcae 70%, #edc271);
  box-shadow: inset 0 3px 8px rgba(106, 61, 22, 0.16), 0 0 0 4px rgba(255, 244, 198, 0.76);
}

.hyper-progress-ring {
  position: absolute;
